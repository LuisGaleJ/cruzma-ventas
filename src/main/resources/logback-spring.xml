<?xml version="1.0" encoding="UTF-8"?>
<!--
  Configuración de Logback (APF3).
  - Consola: mensajes de la aplicación mientras se desarrolla.
  - logs/cruzma-ventas.log: registro general, un archivo por día, se conservan 30 días.
  - logs/auditoria.log: operaciones sensibles (login, usuarios, comprobantes), se conservan 90 días.
  Nunca se registran contraseñas ni documentos completos (ver DatosSeguros.enmascararDocumento).
-->
<configuration>
    <property name="LOG_DIR" value="${LOG_DIR:-logs}"/>
    <property name="PATRON" value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n"/>

    <appender name="CONSOLA" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${PATRON}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="ARCHIVO" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/cruzma-ventas.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/cruzma-ventas.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${PATRON}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="AUDITORIA_ARCHIVO" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/auditoria.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/auditoria.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>90</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Auditoría: solo a su propio archivo -->
    <logger name="AUDITORIA" level="INFO" additivity="false">
        <appender-ref ref="AUDITORIA_ARCHIVO"/>
        <appender-ref ref="CONSOLA"/>
    </logger>

    <!-- Código del sistema con más detalle; librerías solo advertencias -->
    <logger name="pe.cruzma.ventas" level="DEBUG"/>
    <logger name="org.hibernate.SQL" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="CONSOLA"/>
        <appender-ref ref="ARCHIVO"/>
    </root>
</configuration>
